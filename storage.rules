rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function approvedOwner(uid) {
      return request.auth != null && request.auth.uid == uid && (
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) || (
          firestore.exists(/databases/(default)/documents/user_status/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/user_status/$(request.auth.uid)).data.status == 'approved'
        )
      );
    }
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if approvedOwner(uid);
      allow create, update: if approvedOwner(uid) && request.resource.size <= 20 * 1024 * 1024;
    }
  }
}
