# Firebase Functions emulator parameters.
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:5173
AI_MOCK_ENABLED=true

# Explicit values let Firebase CLI resolve the declared parameters on startup.
AI_RUNTIME_SERVICE_ACCOUNT=local-emulator@demo-training-coach.iam.gserviceaccount.com
OPENAI_IDENTITY_PROVIDER_ID=""
OPENAI_SERVICE_ACCOUNT_ID=""
OPENAI_AUDIENCE=https://api.openai.com/v1
OPENAI_GENERAL_MODEL=gpt-5.6-terra
OPENAI_ANALYSIS_MODEL=gpt-5.6-terra
SMTP_HOST=localhost
SMTP_PORT=587
ADMIN_EMAIL=""
