{
  "hosting": {
    "public": "web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "comment": "The HTML shell must revalidate: the default max-age=3600 left returning users on a cached shell pointing at a hashed bundle the new deploy no longer serves — a blank page for up to an hour. Matches '**' because every route rewrites to index.html, so '/index.html' alone never matches a request for '/' or '/routines'. The /assets/** rule below is listed later and so wins for hashed files.",
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "comment": "Asset filenames are content-hashed by vite, so they can be cached forever.",
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "runtime": "python312",
    "ignore": [
      "venv",
      "__pycache__",
      "**/__pycache__/**",
      "**/*.pyc",
      "tests",
      "scripts",
      ".git",
      "firebase-debug.log",
      ".env",
      ".env.*",
      ".secret",
      ".secret.*",
      "*.local",
      "*.local.json",
      "*.pem",
      "*.key",
      "*.p12",
      "*.pfx",
      "service-account*.json",
      "serviceAccount*.json",
      "credentials.json",
      "application_default_credentials.json"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": { "rules": "storage.rules" }
}
