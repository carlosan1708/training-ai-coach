rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownerRole() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function approved() {
      return signedIn() && (ownerRole() || (
        exists(/databases/$(database)/documents/user_status/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_status/$(request.auth.uid)).data.status == 'approved'
      ));
    }
    function approvedOwner(uid) { return approved() && request.auth.uid == uid; }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /user_status/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || ownerRole());
      allow write: if false;
    }
    match /users/{uid}/{document=**} {
      allow read: if approvedOwner(uid);
    }
    // Canonical measurements, jobs, summaries and memory stay server-owned.
    match /users/{uid}/{collection}/{documentId} {
      allow write: if approvedOwner(uid) && collection in [
        'profile', 'logs', 'chat_sessions', 'body_composition_reports',
        'meal_plans', 'routines', 'workout_sessions'
      ];
    }
    match /access_audit/{id} {
      allow read: if ownerRole();
      allow write: if false;
    }
    // Invitations, QA mail and telemetry use validated callables only.
  }
}
